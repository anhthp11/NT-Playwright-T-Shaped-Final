{
    "compilerOptions": {
        "types": [
            "node",
            "@playwright/test"
        ],
        "target": "ES6",
        "module": "es6",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@core/fixtures/*": [
                "./core/fixtures/*"
            ],
            "@core/utils/*": [
                "./core/utils/*"
            ],
            "@page_objects/*": [
                "./page_objects/*"
            ],
            "@api/*": [
                "./core/api/*"
            ],
            "@core/contstants/*": [
                "./core/contstants/*"
            ]
        }
    }
}